{
  "name": "Ascend Sales OS",
  "short_name": "Ascend OS",
  "description": "Owner-first CRM, call desk, callbacks, and appointments for Ascend Sales OS.",
  "start_url": "/app/call-desk",
  "scope": "/",
  "display": "standalone",
  "background_color": "#05070d",
  "theme_color": "#05070d",
  "orientation": "portrait-primary",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/icons/icon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Speed Dialer",
      "short_name": "Dial",
      "description": "Open the next verified lead to call.",
      "url": "/app/call-desk",
      "icons": [{ "src": "/icons/icon.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "Scraper Review",
      "short_name": "Review",
      "description": "Review verified Utah HVAC and plumbing discoveries.",
      "url": "/app/scraper",
      "icons": [{ "src": "/icons/icon.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "Sales Queue",
      "short_name": "Queue",
      "description": "Open the prioritized calling queue.",
      "url": "/app/sales/queue",
      "icons": [{ "src": "/icons/icon.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    }
  ]
}
