generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum PersonalItemStatus {
  OPEN
  DONE
  ARCHIVED
}

enum FocusBlockStatus {
  PLANNED
  ACTIVE
  PAUSED
  DONE
  SKIPPED
  CANCELLED
}

model User {
  id                        String                   @id @default(cuid())
  name                      String?
  email                     String                   @unique
  normalizedEmail           String                   @unique
  emailVerified             DateTime?
  image                     String?
  passwordHash              String
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  accounts                  Account[]
  sessions                  Session[]
  userSessions              UserSession[]
  memberships               OrganizationMembership[]
  notificationPreferences   NotificationPreference[]
  auditEvents               AuditEvent[]             @relation("AuditActor")
  createdOrganizations      Organization[]           @relation("OrganizationCreator")
  sentInvitations           Invitation[]             @relation("InvitationSender")
  personalPriorities        PersonalPriority[]
  operatingNotes            OperatingNote[]
  focusBlocks               FocusBlock[]
  dailyPlans                DailyPlan[]
  goals                     Goal[]
  inAppNotifications        InAppNotification[]
  revenueGoals              RevenueGoal[]
  createdRevenueAdjustments RevenueAdjustment[]      @relation("RevenueAdjustmentCreator")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  lastSeenAt   DateTime @default(now())
  expiresAt    DateTime
  ipHash       String?
  userAgent    String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id                        String                     @id @default(cuid())
  name                      String
  slug                      String                     @unique
  website                   String?
  timezone                  String
  createdById               String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  createdBy                 User?                      @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  memberships               OrganizationMembership[]
  roles                     Role[]
  invitations               Invitation[]
  auditEvents               AuditEvent[]
  notificationPreferences   NotificationPreference[]
  branding                  OrganizationBranding?
  personalPriorities        PersonalPriority[]
  operatingNotes            OperatingNote[]
  focusBlocks               FocusBlock[]
  dailyPlans                DailyPlan[]
  goals                     Goal[]
  inAppNotifications        InAppNotification[]
  clients                   Client[]
  serviceOfferings          ServiceOffering[]
  revenueContracts          RevenueContract[]
  invoices                  Invoice[]
  payments                  Payment[]
  recurringRevenueSchedules RecurringRevenueSchedule[]
  revenueGoals              RevenueGoal[]
  revenueForecastSnapshots  RevenueForecastSnapshot[]
  revenueAdjustments        RevenueAdjustment[]
  leadCampaigns             LeadCampaign[]
  leadBusinesses            LeadBusiness[]
  leadContacts              LeadContact[]
  leadCampaignMemberships   LeadCampaignMembership[]
  leadAnalyses              LeadAnalysis[]
  prospects                 Prospect[]
  outreachAttempts          OutreachAttempt[]
  followUps                 FollowUp[]
  appointments              Appointment[]
  pipelines                 Pipeline[]
  pipelineStages            PipelineStage[]
  opportunities             Opportunity[]
  salesGoals                SalesGoal[]
  contactSuppressions       ContactSuppression[]
  backgroundJobs            BackgroundJob[]
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles          MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model Role {
  id             String           @id @default(cuid())
  organizationId String
  key            String
  name           String
  description    String?
  system         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  memberships    MembershipRole[]

  @@unique([organizationId, key])
  @@index([organizationId])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model MembershipRole {
  id           String                 @id @default(cuid())
  membershipId String
  roleId       String
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role                   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@index([roleId])
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User             @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([email])
}

model AuditEvent {
  id             String        @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipHash         String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@index([action])
}

model NotificationPreference {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  productEmails  Boolean      @default(true)
  activityDigest Boolean      @default(true)
  criticalDue    Boolean      @default(true)
  overdue        Boolean      @default(true)
  focusStarting  Boolean      @default(true)
  goalBehind     Boolean      @default(true)
  dailyPlan      Boolean      @default(true)
  dailyReview    Boolean      @default(true)
  repeatedCarry  Boolean      @default(true)
  longRunning    Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model OrganizationBranding {
  id             String       @id @default(cuid())
  organizationId String       @unique
  logoUrl        String?
  theme          String       @default("dark")
  primaryColor   String       @default("#3B82F6")
  accentColor    String       @default("#38BDF8")
  surfaceColor   String       @default("#0F172A")
  radius         String       @default("8px")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model PersonalPriority {
  id                     String             @id @default(cuid())
  organizationId         String
  userId                 String
  title                  String
  notes                  String?
  description            String?
  status                 PersonalItemStatus @default(OPEN)
  urgency                String             @default("normal")
  priorityLevel          String             @default("medium")
  category               String             @default("other")
  timeframe              String             @default("today")
  dueDate                DateTime?
  dueTime                String?
  estimatedMinutes       Int?
  estimatedRevenueImpact Decimal?           @db.Decimal(12, 2)
  sortOrder              Int                @default(0)
  pinned                 Boolean            @default(false)
  carryoverCount         Int                @default(0)
  completedAt            DateTime?
  archivedAt             DateTime?
  deletedAt              DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  focusBlocks            FocusBlock[]

  @@index([organizationId, userId, status, timeframe, sortOrder])
  @@index([organizationId, userId, dueDate])
  @@index([organizationId, userId, archivedAt])
  @@index([userId, status])
}

model OperatingNote {
  id                  String       @id @default(cuid())
  organizationId      String
  userId              String
  title               String?
  body                String
  pinned              Boolean      @default(false)
  category            String       @default("idea")
  tags                String[]     @default([])
  archivedAt          DateTime?
  convertedPriorityId String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, pinned, archivedAt, createdAt])
  @@index([organizationId, userId, category])
  @@index([userId, createdAt])
}

model FocusBlock {
  id                   String            @id @default(cuid())
  organizationId       String
  userId               String
  priorityId           String?
  title                String
  windowLabel          String
  intention            String?
  status               FocusBlockStatus  @default(PLANNED)
  startsAt             DateTime?
  endsAt               DateTime?
  plannedMinutes       Int?
  actualStartAt        DateTime?
  actualEndAt          DateTime?
  actualFocusedMinutes Int               @default(0)
  pausedAt             DateTime?
  interruptionCount    Int               @default(0)
  completionNote       String?
  calendarEventId      String?
  archivedAt           DateTime?
  sortOrder            Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  priority             PersonalPriority? @relation(fields: [priorityId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, status, startsAt])
  @@index([organizationId, userId, startsAt])
  @@index([organizationId, userId, archivedAt])
  @@index([priorityId])
  @@index([userId, status])
}

model DailyPlan {
  id                  String       @id @default(cuid())
  organizationId      String
  userId              String
  dateKey             String
  timezone            String
  dailyIntention      String?
  topOutcome1         String?
  topOutcome2         String?
  topOutcome3         String?
  mainRisk            String?
  status              String       @default("STARTED")
  startedAt           DateTime?
  endedAt             DateTime?
  completionSummary   String?
  progressMade        String?
  timeWasted          String?
  blockedBy           String?
  carryForward        String?
  removeTomorrow      String?
  tomorrowFirstAction String?
  founderRating       Int?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, dateKey])
  @@index([organizationId, userId, status])
  @@index([organizationId, userId, dateKey])
}

model Goal {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  title          String
  description    String?
  goalType       String
  category       String       @default("other")
  metricType     String       @default("count")
  targetValue    Decimal      @default(1) @db.Decimal(14, 2)
  currentValue   Decimal      @default(0) @db.Decimal(14, 2)
  startDate      DateTime
  endDate        DateTime
  status         String       @default("active")
  unit           String       @default("count")
  ownerId        String?
  archivedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, goalType, status])
  @@index([organizationId, userId, startDate, endDate])
  @@index([organizationId, userId, archivedAt])
}

model InAppNotification {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  type           String
  title          String
  body           String
  entityType     String?
  entityId       String?
  readAt         DateTime?
  dismissedAt    DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt, createdAt])
  @@index([organizationId, userId, type])
}

model RevenueGoal {
  id                String       @id @default(cuid())
  organizationId    String
  ownerUserId       String?
  name              String
  goalPeriod        String
  goalType          String
  startDate         DateTime
  endDate           DateTime
  targetAmountCents Int
  status            String       @default("active")
  primary           Boolean      @default(false)
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner             User?        @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, goalType, startDate, endDate])
  @@index([organizationId, status, primary])
  @@index([ownerUserId])
}

model Client {
  id                 String                     @id @default(cuid())
  organizationId     String
  businessName       String
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  status             String                     @default("prospect")
  source             String?
  notes              String?
  externalProvider   String?
  externalId         String?
  lastSyncedAt       DateTime?
  syncStatus         String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  archivedAt         DateTime?
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contracts          RevenueContract[]
  invoices           Invoice[]
  payments           Payment[]
  recurringSchedules RecurringRevenueSchedule[]
  adjustments        RevenueAdjustment[]
  opportunities      Opportunity[]

  @@index([organizationId, businessName])
  @@index([organizationId, status])
  @@index([organizationId, archivedAt])
  @@index([organizationId, externalProvider, externalId])
}

model ServiceOffering {
  id                String            @id @default(cuid())
  organizationId    String
  name              String
  description       String?
  revenueCategory   String            @default("other")
  defaultPriceCents Int?
  billingType       String            @default("one_time")
  active            Boolean           @default(true)
  externalProvider  String?
  externalId        String?
  lastSyncedAt      DateTime?
  syncStatus        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contracts         RevenueContract[]
  opportunities     Opportunity[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
  @@index([organizationId, revenueCategory])
  @@index([organizationId, externalProvider, externalId])
}

model RevenueContract {
  id                    String                     @id @default(cuid())
  organizationId        String
  clientId              String
  serviceOfferingId     String?
  name                  String
  contractedAmountCents Int
  billingType           String
  startDate             DateTime?
  endDate               DateTime?
  status                String                     @default("draft")
  expectedCloseDate     DateTime?
  signedDate            DateTime?
  cancellationDate      DateTime?
  mrrAmountCents        Int?
  depositAmountCents    Int?
  notes                 String?
  externalProvider      String?
  externalId            String?
  lastSyncedAt          DateTime?
  syncStatus            String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  archivedAt            DateTime?
  organization          Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client                Client                     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceOffering       ServiceOffering?           @relation(fields: [serviceOfferingId], references: [id], onDelete: SetNull)
  invoices              Invoice[]
  payments              Payment[]
  recurringSchedules    RecurringRevenueSchedule[]
  adjustments           RevenueAdjustment[]
  sourceOpportunityId   String?
  sourceOpportunity     Opportunity?               @relation("OpportunityRevenueContract", fields: [sourceOpportunityId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@index([organizationId, serviceOfferingId])
  @@index([organizationId, signedDate])
  @@index([organizationId, startDate, endDate])
  @@index([organizationId, archivedAt])
  @@index([organizationId, externalProvider, externalId])
  @@index([organizationId, sourceOpportunityId])
}

model Invoice {
  id                     String              @id @default(cuid())
  organizationId         String
  clientId               String
  revenueContractId      String?
  externalProvider       String?
  externalInvoiceId      String?
  invoiceNumber          String?
  issueDate              DateTime
  dueDate                DateTime
  totalAmountCents       Int
  amountPaidCents        Int                 @default(0)
  amountOutstandingCents Int
  status                 String              @default("open")
  currency               String              @default("USD")
  notes                  String?
  lastSyncedAt           DateTime?
  syncStatus             String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  paidAt                 DateTime?
  archivedAt             DateTime?
  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client                 Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contract               RevenueContract?    @relation(fields: [revenueContractId], references: [id], onDelete: SetNull)
  payments               Payment[]
  adjustments            RevenueAdjustment[]

  @@index([organizationId, dueDate])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@index([organizationId, revenueContractId])
  @@index([organizationId, archivedAt])
  @@index([organizationId, externalProvider, externalInvoiceId])
}

model Payment {
  id                  String              @id @default(cuid())
  organizationId      String
  clientId            String
  invoiceId           String?
  revenueContractId   String?
  paymentDate         DateTime
  amountCents         Int
  paymentMethod       String?
  status              String              @default("succeeded")
  externalProvider    String?
  externalPaymentId   String?
  idempotencyKey      String?
  isRefunded          Boolean             @default(false)
  refundedAmountCents Int                 @default(0)
  notes               String?
  lastSyncedAt        DateTime?
  syncStatus          String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client              Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  invoice             Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  contract            RevenueContract?    @relation(fields: [revenueContractId], references: [id], onDelete: SetNull)
  adjustments         RevenueAdjustment[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, paymentDate])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@index([organizationId, invoiceId])
  @@index([organizationId, revenueContractId])
  @@index([organizationId, externalProvider, externalPaymentId])
}

model RecurringRevenueSchedule {
  id                String          @id @default(cuid())
  organizationId    String
  clientId          String
  revenueContractId String
  amountCents       Int
  frequency         String
  startDate         DateTime
  endDate           DateTime?
  nextExpectedDate  DateTime
  status            String          @default("active")
  externalProvider  String?
  externalId        String?
  lastSyncedAt      DateTime?
  syncStatus        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contract          RevenueContract @relation(fields: [revenueContractId], references: [id], onDelete: Cascade)

  @@index([organizationId, nextExpectedDate])
  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@index([organizationId, revenueContractId])
  @@index([organizationId, externalProvider, externalId])
}

model RevenueForecastSnapshot {
  id                      String       @id @default(cuid())
  organizationId          String
  forecastDate            DateTime     @default(now())
  periodStart             DateTime
  periodEnd               DateTime
  worstCaseAmountCents    Int
  expectedAmountCents     Int
  bestCaseAmountCents     Int
  contractedAmountCents   Int
  expectedCashAmountCents Int
  overdueAmountCents      Int
  mrrCents                Int
  assumptions             Json
  createdAt               DateTime     @default(now())
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, forecastDate])
  @@index([organizationId, periodStart, periodEnd])
}

model RevenueAdjustment {
  id                String           @id @default(cuid())
  organizationId    String
  clientId          String?
  invoiceId         String?
  paymentId         String?
  revenueContractId String?
  adjustmentType    String
  amountCents       Int
  reason            String
  effectiveDate     DateTime
  createdById       String?
  createdAt         DateTime         @default(now())
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client            Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  invoice           Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment           Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  contract          RevenueContract? @relation(fields: [revenueContractId], references: [id], onDelete: SetNull)
  createdBy         User?            @relation("RevenueAdjustmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, effectiveDate])
  @@index([organizationId, adjustmentType])
  @@index([organizationId, clientId])
  @@index([organizationId, invoiceId])
  @@index([organizationId, paymentId])
  @@index([organizationId, revenueContractId])
}

model LeadCampaign {
  id                 String                   @id @default(cuid())
  organizationId     String
  name               String
  industry           String
  subIndustry        String?
  country            String                   @default("United States")
  state              String?
  metroArea          String?
  city               String?
  searchRadiusMiles  Int?
  searchTerms        String[]
  minReviewCount     Int?
  maxReviewCount     Int?
  minRating          Decimal?                 @db.Decimal(3, 2)
  maxRating          Decimal?                 @db.Decimal(3, 2)
  ownerOperatedOnly  Boolean                  @default(false)
  excludeFranchises  Boolean                  @default(true)
  excludeSuppliers   Boolean                  @default(true)
  excludeSchools     Boolean                  @default(true)
  excludeJobListings Boolean                  @default(true)
  excludeParts       Boolean                  @default(true)
  targetLeadCount    Int                      @default(100)
  status             String                   @default("draft")
  sourceProvider     String                   @default("google_places")
  createdByUserId    String?
  startedAt          DateTime?
  completedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships        LeadCampaignMembership[]
  prospects          Prospect[]
  jobs               BackgroundJob[]

  @@index([organizationId, status])
  @@index([organizationId, sourceProvider])
  @@index([organizationId, industry, city, state])
  @@index([createdByUserId])
}

model LeadBusiness {
  id                      String                   @id @default(cuid())
  organizationId          String
  businessName            String
  normalizedBusinessName  String
  primaryPhone            String?
  normalizedPhone         String?
  websiteUrl              String?
  normalizedDomain        String?
  address                 String?
  city                    String?
  state                   String?
  postalCode              String?
  country                 String                   @default("United States")
  latitude                Decimal?                 @db.Decimal(10, 7)
  longitude               Decimal?                 @db.Decimal(10, 7)
  industry                String?
  subIndustry             String?
  googlePlaceId           String?
  googleMapsUrl           String?
  rating                  Decimal?                 @db.Decimal(3, 2)
  reviewCount             Int?
  businessStatus          String?
  source                  String                   @default("manual")
  sourceRecordId          String?
  franchiseStatus         String?
  ownerOperatedLikelihood Int?
  estimatedCompanySize    String?
  notes                   String?
  archivedAt              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts                LeadContact[]
  campaignMemberships     LeadCampaignMembership[]
  analyses                LeadAnalysis[]
  prospects               Prospect[]
  suppressions            ContactSuppression[]

  @@unique([organizationId, googlePlaceId])
  @@index([organizationId, normalizedPhone])
  @@index([organizationId, normalizedDomain])
  @@index([organizationId, normalizedBusinessName, address])
  @@index([organizationId, industry, city, state])
  @@index([organizationId, archivedAt])
}

model LeadContact {
  id                 String            @id @default(cuid())
  organizationId     String
  leadBusinessId     String
  firstName          String?
  lastName           String?
  fullName           String?
  jobTitle           String?
  role               String?
  email              String?
  phone              String?
  isOwner            Boolean           @default(false)
  isDecisionMaker    Boolean           @default(false)
  confidenceScore    Int?
  source             String            @default("manual")
  verificationStatus String            @default("unverified")
  notes              String?
  archivedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadBusiness       LeadBusiness      @relation(fields: [leadBusinessId], references: [id], onDelete: Cascade)
  prospects          Prospect[]
  attempts           OutreachAttempt[]
  appointments       Appointment[]

  @@index([organizationId, leadBusinessId])
  @@index([organizationId, email])
  @@index([organizationId, phone])
}

model LeadCampaignMembership {
  id                     String       @id @default(cuid())
  organizationId         String
  campaignId             String
  leadBusinessId         String
  addedAt                DateTime     @default(now())
  sourceRank             Int?
  searchQuery            String?
  originalResultPosition Int?
  campaignStatus         String       @default("new")
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign               LeadCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadBusiness           LeadBusiness @relation(fields: [leadBusinessId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadBusinessId])
  @@index([organizationId, campaignStatus])
  @@index([organizationId, leadBusinessId])
}

model LeadAnalysis {
  id                         String       @id @default(cuid())
  organizationId             String
  leadBusinessId             String
  websiteStatus              String       @default("unknown")
  websiteQualityScore        Int          @default(0)
  mobileQualityScore         Int          @default(0)
  conversionQualityScore     Int          @default(0)
  seoWeaknessScore           Int          @default(0)
  gbpWeaknessScore           Int          @default(0)
  automationOpportunityScore Int          @default(0)
  ownerAccessibilityScore    Int          @default(0)
  abilityToPayScore          Int          @default(0)
  urgencyScore               Int          @default(0)
  overallFitScore            Int          @default(0)
  classification             String       @default("needs_review")
  primaryWeaknesses          String[]
  recommendedService         String?
  researchSummary            String?
  evidence                   Json
  analyzerVersion            String       @default("deterministic-v1")
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt
  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadBusiness               LeadBusiness @relation(fields: [leadBusinessId], references: [id], onDelete: Cascade)

  @@index([organizationId, classification])
  @@index([organizationId, leadBusinessId, createdAt])
}

model Prospect {
  id                  String               @id @default(cuid())
  organizationId      String
  leadBusinessId      String
  primaryContactId    String?
  assignedUserId      String?
  status              String               @default("new")
  priority            String               @default("standard")
  leadSource          String               @default("manual")
  leadCampaignId      String?
  lastContactAt       DateTime?
  nextActionAt        DateTime?
  nextActionType      String?
  attemptCount        Int                  @default(0)
  noAnswerCount       Int                  @default(0)
  conversationCount   Int                  @default(0)
  estimatedValueCents Int?
  recommendedService  String?
  notes               String?
  archivedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadBusiness        LeadBusiness         @relation(fields: [leadBusinessId], references: [id], onDelete: Cascade)
  primaryContact      LeadContact?         @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)
  leadCampaign        LeadCampaign?        @relation(fields: [leadCampaignId], references: [id], onDelete: SetNull)
  outreachAttempts    OutreachAttempt[]
  followUps           FollowUp[]
  appointments        Appointment[]
  opportunities       Opportunity[]
  suppressions        ContactSuppression[]

  @@unique([organizationId, leadBusinessId, archivedAt])
  @@index([organizationId, assignedUserId, status])
  @@index([organizationId, nextActionAt])
  @@index([organizationId, priority, status])
  @@index([organizationId, leadCampaignId])
}

model OutreachAttempt {
  id                 String       @id @default(cuid())
  organizationId     String
  prospectId         String
  userId             String?
  contactId          String?
  channel            String
  direction          String       @default("outbound")
  startedAt          DateTime
  completedAt        DateTime?
  durationSeconds    Int?
  outcome            String
  notes              String?
  externalProvider   String?
  externalActivityId String?
  recordingUrl       String?
  transcriptStatus   String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospect           Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  contact            LeadContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  followUps          FollowUp[]

  @@index([organizationId, userId, startedAt])
  @@index([organizationId, prospectId, startedAt])
  @@index([organizationId, outcome])
  @@index([externalProvider, externalActivityId])
}

model FollowUp {
  id                       String           @id @default(cuid())
  organizationId           String
  prospectId               String
  assignedUserId           String?
  relatedOutreachAttemptId String?
  type                     String
  dueAt                    DateTime
  status                   String           @default("open")
  priority                 String           @default("standard")
  notes                    String?
  completedAt              DateTime?
  archivedAt               DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  organization             Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospect                 Prospect         @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  relatedOutreachAttempt   OutreachAttempt? @relation(fields: [relatedOutreachAttemptId], references: [id], onDelete: SetNull)

  @@index([organizationId, assignedUserId, status])
  @@index([organizationId, dueAt])
  @@index([organizationId, prospectId, status])
}

model Appointment {
  id                 String       @id @default(cuid())
  organizationId     String
  prospectId         String
  opportunityId      String?
  assignedSetterId   String?
  assignedCloserId   String?
  contactId          String?
  title              String
  startAt            DateTime
  endAt              DateTime
  timezone           String
  status             String       @default("scheduled")
  meetingType        String       @default("discovery")
  meetingUrl         String?
  location           String?
  bookingSource      String?
  notes              String?
  confirmationStatus String       @default("pending")
  reminderStatus     String       @default("not_sent")
  externalCalendarId String?
  externalEventId    String?
  completedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospect           Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  opportunity        Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  contact            LeadContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([organizationId, assignedSetterId, startAt])
  @@index([organizationId, assignedCloserId, startAt])
  @@index([organizationId, startAt])
  @@index([organizationId, status])
  @@index([organizationId, opportunityId])
}

model Pipeline {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isDefault      Boolean         @default(false)
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages         PipelineStage[]

  @@unique([organizationId, name])
  @@index([organizationId, isDefault])
  @@index([organizationId, archivedAt])
}

model PipelineStage {
  id                 String        @id @default(cuid())
  organizationId     String
  pipelineId         String
  name               String
  sortOrder          Int
  defaultProbability Int           @default(10)
  isWonStage         Boolean       @default(false)
  isLostStage        Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline           Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities      Opportunity[]

  @@unique([pipelineId, name])
  @@index([organizationId, pipelineId, sortOrder])
  @@index([organizationId, isWonStage, isLostStage])
}

model Opportunity {
  id                  String            @id @default(cuid())
  organizationId      String
  prospectId          String
  clientId            String?
  assignedCloserId    String?
  name                String
  pipelineStageId     String
  serviceOfferingId   String?
  estimatedValueCents Int
  weightedValueCents  Int
  probabilityPercent  Int
  expectedCloseDate   DateTime?
  lastActivityAt      DateTime?
  nextActionAt        DateTime?
  status              String            @default("open")
  lossReason          String?
  notes               String?
  wonAt               DateTime?
  lostAt              DateTime?
  archivedAt          DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospect            Prospect          @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  client              Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  pipelineStage       PipelineStage     @relation(fields: [pipelineStageId], references: [id], onDelete: Restrict)
  serviceOffering     ServiceOffering?  @relation(fields: [serviceOfferingId], references: [id], onDelete: SetNull)
  appointments        Appointment[]
  revenueContracts    RevenueContract[] @relation("OpportunityRevenueContract")

  @@index([organizationId, pipelineStageId])
  @@index([organizationId, assignedCloserId, status])
  @@index([organizationId, expectedCloseDate])
  @@index([organizationId, prospectId])
  @@index([organizationId, clientId])
  @@index([organizationId, status])
}

model SalesGoal {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  teamId         String?
  periodType     String
  startDate      DateTime
  endDate        DateTime
  metric         String
  targetValue    Int
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, metric, startDate, endDate])
  @@index([organizationId, status])
}

model ContactSuppression {
  id             String        @id @default(cuid())
  organizationId String
  phone          String?
  email          String?
  leadBusinessId String?
  prospectId     String?
  channel        String
  reason         String
  source         String        @default("manual")
  createdById    String?
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadBusiness   LeadBusiness? @relation(fields: [leadBusinessId], references: [id], onDelete: SetNull)
  prospect       Prospect?     @relation(fields: [prospectId], references: [id], onDelete: SetNull)

  @@index([organizationId, phone, channel])
  @@index([organizationId, email, channel])
  @@index([organizationId, leadBusinessId])
  @@index([organizationId, prospectId])
}

model BackgroundJob {
  id              String        @id @default(cuid())
  organizationId  String
  campaignId      String?
  type            String
  status          String        @default("queued")
  input           Json
  progressCurrent Int           @default(0)
  progressTotal   Int           @default(0)
  resultSummary   Json?
  errorMessage    String?
  attemptCount    Int           @default(0)
  maxAttempts     Int           @default(3)
  lockedAt        DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  heartbeatAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign        LeadCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, type])
  @@index([organizationId, campaignId])
  @@index([status, lockedAt])
}
