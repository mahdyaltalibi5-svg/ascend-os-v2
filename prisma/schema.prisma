  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, endpointHash])
  @@index([organizationId, userId, enabled])
}

model OwnerReachScoreReview {
  id              String       @id @default(cuid())
  organizationId  String
  leadBusinessId  String
  reviewedById    String?
  previousScore   Int
  newScore        Int
  previousReasons String[]
  newReasons      String[]
  reason          String
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadBusiness    LeadBusiness @relation(fields: [leadBusinessId], references: [id], onDelete: Cascade)
  reviewedBy      User?        @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, leadBusinessId, createdAt])
  @@index([organizationId, reviewedById])
}
