DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
APP_ENV="development"
TEST_DATABASE_URL="postgresql://ascend_test:ascend_test_password@localhost:5433/ascend_os_test?schema=public"
PLAYWRIGHT_OUTPUT_DIR="/private/tmp/ascend-os-playwright-results"

# Optional future lead-provider job support. Leave empty unless provider jobs are enabled.
GOOGLE_PLACES_API_KEY=""
SALES_WORKER_SECRET="replace-with-a-long-random-worker-secret"
CRON_SECRET=""

# Milestone 2 intentionally has no Twilio, SMS automation, scraping, Google Calendar,
# predictive dialing, call recording, or push-provider delivery secrets.
